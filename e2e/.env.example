# Copy to `.env` and fill in. `.env` is gitignored — never commit real credentials.
# (Loaded by fixtures/env.ts; you can also just export these in your shell.)

# Where to point the suite. Defaults target production.
E2E_BASE_URL=https://dance.takelord.com
E2E_API_URL=https://dance-api.takelord.com/api

# Local dev pair instead:
# E2E_BASE_URL=http://localhost:4200
# E2E_API_URL=http://localhost:5000/api

# Throwaway account used by the `authed` project. Without these the authed suite
# is skipped (not failed). Use a disposable account — the authed tests write to
# whichever database E2E_API_URL points at.
E2E_USERNAME=
E2E_PASSWORD=
