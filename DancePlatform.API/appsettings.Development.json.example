{
  "_comment": "Copy this to appsettings.Development.json (gitignored) and fill in real local values. Production supplies these via environment variables (ConnectionStrings__Default, Jwt__Key, ...).",
  "ConnectionStrings": {
    "Default": "Host=YOUR_DB_HOST;Database=dancing;Username=dance_user;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Key": "a-local-dev-signing-key-at-least-32-characters-long"
  },
  "_email": "Optional. With no SMTP host the password-reset flow still works end to end — the mail is written to the log at Warning instead of being sent, so the link is in the console. Production sets Email__From and Email__Smtp__* as environment variables.",
  "Email": {
    "From": "no-reply@example.com",
    "Smtp": {
      "Host": "smtp.example.com",
      "Port": 587,
      "User": "YOUR_SMTP_USERNAME",
      "Password": "YOUR_SMTP_PASSWORD",
      "UseSsl": true
    }
  },
  "_social_signin": "Optional. Leave a provider blank and its sign-in button simply isn't offered. Google redirect URI to register: http://localhost:5000/api/auth/external/google/callback",
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    },
    "Facebook": {
      "AppId": "YOUR_FACEBOOK_APP_ID",
      "AppSecret": "YOUR_FACEBOOK_APP_SECRET"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
