        {
          "slug": "tutting-basics",
          "name": "Tutting basics",
          "difficulty": "Beginner",
          "danceSlug": "tutting",
          "summary": "A first full pass through the style: angles, boxes and a short phrase.",
          "description": "Watch a beginner tutorial from start to finish before drilling anything, so the later concepts have something to attach to. Most beginner lessons follow the same order: stretch, find the 90° angle, make a few basic positions, then join them into a short combo.",
          "steps": [
            "Stretch the wrists and fingers.",
            "Hold the arms in right angles at chest height.",
            "Move from one basic position to the next, hitting each one.",
            "String four positions into an eight-count."
          ],
          "tips": [
            "Come back to this whenever a concept stops making sense on its own."
          ],
          "related": ["right-angles", "the-hit", "tutting-combo"]
        },
        {
          "slug": "the-hit",
          "name": "The hit",
          "difficulty": "Beginner",
          "danceSlug": "the-hit",
          "summary": "Pop into a shape, hold it, snap to the next — the grammar of tutting.",
          "description": "Tutting is a popping element, and the hit is its founding mechanic: a sharp contraction as the arm arrives in a position, a clean hold, and a snap to the next with nothing visible in between. Shapes are the vocabulary; the hit is the grammar.",
          "steps": [
            "Hold the arms in a right angle.",
            "Tense the forearms and hands sharply on the beat as you arrive.",
            "Hold the shape still.",
            "Snap to the next position and hit again."
          ],
          "tips": [
            "If you can see the arm travelling between shapes, the hit is missing."
          ],
          "related": ["right-angles", "tutting", "hinges"]
        },
        {
          "slug": "right-angles",
          "name": "Right angles",
          "aliases": ["90 degree rule", "90s"],
          "difficulty": "Beginner",
          "danceSlug": "right-angles",
          "summary": "The 90° angle — the basic unit of the whole style.",
          "description": "Every shape in tutting is built from right angles: elbows and wrists square, lines flat to the floor or straight up. The \"90-degree rule\" is that the hand stays straight in line with the forearm and the forearm meets the upper arm at 90°. A bent wrist (the \"duck face\") is the most common mistake.",
          "steps": [
            "Raise the upper arm level with the shoulder.",
            "Bend the elbow to 90°, forearm straight up.",
            "Keep the hand flat and in line with the forearm.",
            "Check the angle in a mirror against a door frame."
          ],
          "tips": [
            "Push the palm against a wall for a few minutes a day to extend the wrist's range."
          ],
          "related": ["the-hit", "king-tut", "tutting-stretches"]
        },
        {
          "slug": "tutting-stretches",
          "name": "Hand and wrist stretches",
          "aliases": ["stretches"],
          "difficulty": "Beginner",
          "danceSlug": "tutting-stretches",
          "summary": "Stretching the wrists and fingers before every session.",
          "description": "Tutting holds the wrists and fingers at the end of their range for minutes at a time, and that range is the hard limit on how clean your angles can be. Two minutes of stretching before every session is part of the technique, not an extra.",
          "steps": [
            "Pull the fingers of one hand back gently with the other hand.",
            "Press both palms flat against a wall with the fingers pointing down.",
            "Circle the wrists slowly in both directions.",
            "Spread and close the fingers several times."
          ],
          "tips": [
            "Never force a stretch to pain. Range comes over weeks."
          ],
          "related": ["right-angles", "wrist-rolls"]
        },
        {
          "slug": "wrist-rolls",
          "name": "Wrist rolls",
          "difficulty": "Beginner",
          "danceSlug": "wrist-rolls",
          "summary": "Rolling the hand through its range while the forearm stays locked.",
          "description": "A wrist roll turns the hand in a circle around the wrist while the forearm stays still. It is the joint movement that joins one angle to the next, and the easiest way to make a flat shape read as three-dimensional.",
          "steps": [
            "Hold the forearm still in front of you.",
            "Roll the hand down, out, up and in around the wrist.",
            "Keep the forearm locked.",
            "Roll the other way, then both hands together."
          ],
          "related": ["hinges", "tutting-stretches", "finger-rolls"]
        },
        {
          "slug": "king-tut",
          "name": "King Tut",
          "aliases": ["king tuts", "Egyptian"],
          "difficulty": "Beginner",
          "danceSlug": "king-tut",
          "summary": "The origin move: forearms and upper arms flat and square to the audience, Egyptian-style.",
          "description": "The King Tut is the original tutting figure, taken from the side-on, angular poses of Egyptian wall art. Forearms and upper arms stay flat and everything is square to the audience. Mr. Wiggles teaches it as an exercise in cleaner angles, and it is the best diagnostic of whether your right angles are really right.",
          "steps": [
            "Raise one arm to the side with the elbow bent to 90°.",
            "Bring the other arm across the body at 90°.",
            "Keep both hands flat and in line with the forearms.",
            "Switch positions, hitting each one."
          ],
          "related": ["right-angles", "box-tuts", "tutting"]
        },
        {
          "slug": "fixed-points",
          "name": "Fixed points",
          "aliases": ["fixed point"],
          "difficulty": "Intermediate",
          "danceSlug": "fixed-points",
          "summary": "Choosing a point that does not move while everything rotates around it.",
          "description": "A fixed point is a knuckle, elbow or fingertip that stays exactly where it is while the rest of the body moves around it. It is the concept that turns a sequence of poses into an illusion, and one of the most often skipped.",
          "steps": [
            "Place a fingertip on an imaginary point in the air.",
            "Move the elbow and body around it.",
            "Keep the fingertip absolutely still.",
            "Try it with the elbow or the wrist as the fixed point."
          ],
          "tips": [
            "Practise against a real surface first — a wall or a table — then take the wall away."
          ],
          "related": ["isolation-points", "the-magic-box", "hinges"]
        }
      ]
